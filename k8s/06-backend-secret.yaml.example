apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: healops
  labels:
    app.kubernetes.io/name: healops-backend
    app.kubernetes.io/component: api
    app.kubernetes.io/part-of: healops
type: Opaque
stringData:
  JWT_SECRET: "CHANGE_ME_JWT_SECRET"
  DATABASE_URL: "postgres://healops:CHANGE_ME_SECURE_PASSWORD@healops-postgres:5432/healops"
