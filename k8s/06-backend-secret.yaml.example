apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: healops
  labels:
    app.kubernetes.io/name: healops-backend
    app.kubernetes.io/component: api
    app.kubernetes.io/part-of: healops
type: Opaque
stringData:
  JWT_SECRET: "<YOUR_RANDOM_JWT_SECRET>"
  DATABASE_URL: "postgres://healops:<YOUR_STRONG_DATABASE_PASSWORD>@healops-postgres:5432/healops"
