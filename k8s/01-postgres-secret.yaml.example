apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: healops
  labels:
    app.kubernetes.io/name: healops-postgres
    app.kubernetes.io/part-of: healops
type: Opaque
stringData:
  POSTGRES_USER: "healops"
  POSTGRES_PASSWORD: "CHANGE_ME_SECURE_PASSWORD"
  POSTGRES_DB: "healops"
