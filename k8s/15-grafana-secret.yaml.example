apiVersion: v1
kind: Secret
metadata:
  name: grafana-secret
  namespace: healops
  labels:
    app.kubernetes.io/name: healops-grafana
    app.kubernetes.io/component: monitoring
    app.kubernetes.io/part-of: healops
type: Opaque
stringData:
  admin-user: "healops_admin"
  admin-password: "<YOUR_GRAFANA_PASSWORD>"
